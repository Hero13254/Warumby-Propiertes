# Local: deixe DATABASE_URL vazio para continuar usando db.sqlite3.
GESTAO_SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria
GESTAO_DEBUG=0
GESTAO_ALLOWED_HOSTS=seu-projeto.vercel.app
GESTAO_CSRF_TRUSTED_ORIGINS=https://seu-projeto.vercel.app
GESTAO_SECURE_COOKIES=1

# Supabase Postgres: use a connection string do Transaction Pooler para Vercel.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@POOLER_HOST:6543/postgres
SUPABASE_TRANSACTION_POOLER=1
DB_SSL_REQUIRE=1

# Supabase Storage S3 (bucket privado)
USE_SUPABASE_STORAGE=1
SUPABASE_S3_BUCKET=warumby-private
SUPABASE_S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=REGIAO_DO_PROJETO
SUPABASE_S3_ACCESS_KEY_ID=SEU_ACCESS_KEY_ID
SUPABASE_S3_SECRET_ACCESS_KEY=SEU_SECRET_ACCESS_KEY
